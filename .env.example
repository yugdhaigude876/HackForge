# Reserve Juggler Environment Configuration
# Copy this file to .env.local for local overrides. Never commit secrets.

# Browser-safe Firebase Client SDK Configuration:
# In development (NODE_ENV !== "production"), if these are omitted the app gracefully runs in local Mock Auth mode.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Fail-Closed Mock Security:
# In production (NODE_ENV === "production"), mock auth is disabled by default.
# Set NEXT_PUBLIC_ALLOW_MOCK_AUTH=true ONLY to explicitly permit mock auth in production demo/testing environments.
NEXT_PUBLIC_ALLOW_MOCK_AUTH=

# Default Active Organisation ID for Engine API calls (optional, defaults to org_demo)
NEXT_PUBLIC_DEFAULT_ORG_ID=org_demo

# Local Firebase Auth Emulator (optional for local testing against protected APIs)
# NEXT_PUBLIC_USE_AUTH_EMULATOR=true
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Server-only (never prefix with NEXT_PUBLIC_): Firebase Admin service account JSON (single line)
FIREBASE_SERVICE_ACCOUNT_JSON=
